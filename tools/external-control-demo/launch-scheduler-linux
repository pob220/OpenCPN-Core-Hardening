#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
demo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
token_file="$demo_root/secrets/api-token"
scheduler="$demo_root/client/bin/opencpn-scheduler"
demo_url=https://127.0.0.1:8443

[[ -x "$scheduler" && -r "$token_file" ]] || {
  echo 'The External Control Demo is incomplete; rerun its installer.' >&2
  exit 1
}
mkdir -p "$demo_root/scheduler"
exec 9>"$demo_root/scheduler/gui.lock"
flock -n 9 || { echo 'The External Control Demo Scheduler is already running.' >&2; exit 0; }
export OPENCPN_URL="$demo_url"
export OPENCPN_TOKEN=$(<"$token_file")
export XDG_DATA_HOME="$demo_root/xdg-data"

api_ready() {
  curl --silent --insecure --fail --max-time 2 \
    --header "Authorization: Bearer $OPENCPN_TOKEN" \
    "$demo_url/api/v2/version" >/dev/null 2>&1
}
if ! api_ready; then
  "$demo_root/bin/launch-opencpn-external-control-demo" 9>&- &
  for _attempt in $(seq 1 90); do api_ready && break; sleep 1; done
fi
api_ready || { echo 'The External Control Demo API did not become ready.' >&2; exit 1; }
exec "$scheduler" --insecure \
  --database "$demo_root/scheduler/scheduler.sqlite3" \
  --secret-directory "$demo_root/secrets" gui
